DATABASE_URL=postgresql://postgres:password@localhost:5432/student_outreach
# Optional direct PostgreSQL URL for session advisory locks. Neon pooler URLs are converted to
# their direct hostname automatically when this is omitted.
DATABASE_DIRECT_URL=
JWT_SIGNING_SECRET=change-me-32-chars-minimum
# OAuth 2.0 web client ID used to verify Google Identity Services ID tokens.
GOOGLE_CLIENT_ID=719679889441-oto6bdqapcrdmcso8lsfs46qc4nvpb3s.apps.googleusercontent.com
# Password authentication has an in-memory front-door limit plus durable,
# database-backed per-account and per-IP hourly limits.
RATE_LIMIT_AUTH_PER_15_MINUTES=20
RATE_LIMIT_VERIFY_PER_15_MINUTES=40
RATE_PASSWORD_LOGIN_PER_HOUR=10
RATE_PASSWORD_LOGIN_IP_PER_HOUR=100
RATE_PASSWORD_CHANGE_PER_HOUR=5
RATE_PASSWORD_CHANGE_IP_PER_HOUR=30
ANTHROPIC_API_KEY=sk-ant-...
# Composio API key for read-only application verification code lookup. The authenticated Litos
# user UUID is passed as the Composio user ID, so existing Gmail or Outlook connections must use
# the same stable identifier. Toolkit versions are pinned and can be advanced after contract tests.
COMPOSIO_API_KEY=
COMPOSIO_API_BASE=https://backend.composio.dev
# Optional production auth configs. Set these when using Litos-owned OAuth apps for custom
# branding or narrower provider scopes. Without them, Composio managed authentication is used.
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_OUTLOOK=
COMPOSIO_TOOLKIT_VERSION_GMAIL=20260702_01
COMPOSIO_TOOLKIT_VERSION_OUTLOOK=20260714_00
# AES-256-GCM key for application_profile column-level encryption (phone/address/work-auth).
# Any secret string works; scrypt derives the fixed-length key. Rotating this re-encrypts nothing
# automatically - existing rows become undecryptable, so treat it like JWT_SIGNING_SECRET (set once).
ENCRYPTION_KEY=change-me-32-chars-minimum
# Vercel Blob read-write token (Storage tab -> Create -> Blob), used to store generated resume files.
# Also required by the daily retention sweep, which deletes resume files past the window stated
# in the privacy policy.
BLOB_READ_WRITE_TOKEN=
# Absolute base URL this API is reached at, used to build resume download links. Optional:
# derived from x-forwarded-proto/host when unset, which is correct on Vercel. Set it only if the
# API is served on a different hostname than the one requests arrive on.
PUBLIC_API_BASE=
REOON_API_KEY=
MILLIONVERIFIER_API_KEY=
BOUNCEBAN_API_KEY=
# Hunter.io API key - primary provider for BOTH contact discovery (Domain Search) and
# email verification (Email Verifier). Cheapest path; falls back to Apollo + Reoon/BounceBan.
HUNTER_API_KEY=
# Apollo People Search API key (Settings -> Integrations -> API). Fallback contact source.
APOLLO_API_KEY=
# Optional JSON array of extra first-party ATS boards loaded by the daily monitor.
# Each item: {"company_name":"Acme","ats_name":"greenhouse|lever|ashby|workable","board_token":"acme","career_url":"https://..."}
JOB_MONITOR_SOURCES_JSON=[]
# Reusable Lemon Squeezy share URL. It must contain /checkout/buy/, never the single-use
# /checkout/?cart= URL. The authenticated checkout endpoint adds the Litos user ID and email.
LEMONSQUEEZY_CHECKOUT_URL=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Leave false in production. Enable only in an isolated test deployment.
LEMONSQUEEZY_ACCEPT_TEST_MODE=false
# Optional first-party fallback URL for older extension clients.
UPGRADE_URL=
PORT=3001
