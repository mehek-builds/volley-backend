DATABASE_URL=postgresql://postgres:password@localhost:5432/student_outreach
# Optional direct PostgreSQL URL for session advisory locks. Neon pooler URLs are converted to
# their direct hostname automatically when this is omitted.
DATABASE_DIRECT_URL=
JWT_SIGNING_SECRET=change-me-32-chars-minimum
# OAuth 2.0 web client ID used to verify Google Identity Services ID tokens.
GOOGLE_CLIENT_ID=719679889441-oto6bdqapcrdmcso8lsfs46qc4nvpb3s.apps.googleusercontent.com
# Password authentication has an in-memory front-door limit plus durable,
# database-backed per-account and per-IP hourly limits.
RATE_LIMIT_AUTH_PER_15_MINUTES=20
RATE_LIMIT_VERIFY_PER_15_MINUTES=40
RATE_PASSWORD_LOGIN_PER_HOUR=10
RATE_PASSWORD_LOGIN_IP_PER_HOUR=100
RATE_PASSWORD_CHANGE_PER_HOUR=5
RATE_PASSWORD_CHANGE_IP_PER_HOUR=30
ANTHROPIC_API_KEY=sk-ant-...
# Primary generation provider. Keep this server-side only; Anthropic remains the runtime fallback.
OPENAI_API_KEY=sk-proj-...
# Optional override. Defaults to the quality/cost-balanced production model below.
OPENAI_GENERATION_MODEL=gpt-5.6-terra
# Composio API key for read-only application verification code lookup. The authenticated Litos
# user UUID is passed as the Composio user ID, so existing Gmail or Outlook connections must use
# the same stable identifier. Toolkit versions are pinned and can be advanced after contract tests.
COMPOSIO_API_KEY=
COMPOSIO_API_BASE=https://backend.composio.dev
# Optional production auth configs. Set these when using Litos-owned OAuth apps for custom
# branding or narrower provider scopes. Without them, Composio managed authentication is used.
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_OUTLOOK=
COMPOSIO_TOOLKIT_VERSION_GMAIL=20260702_01
COMPOSIO_TOOLKIT_VERSION_OUTLOOK=20260714_00
# Optional Litos-controlled applicant inbox. Prefer the main mailbox mode when Litos mail is on
# Google Workspace: applications@trylitos.com receives applications+app-...@trylitos.com, so no
# catch-all MX is required. If only LITOS_APPLICATION_EMAIL_DOMAIN is set, aliases use
# app-...@that-domain and the domain must catch all inbound mail.
LITOS_APPLICATION_EMAIL_MAILBOX=
LITOS_APPLICATION_EMAIL_DOMAIN=
LITOS_APPLICATION_EMAIL_ALIAS_SECRET=
# Explicit application-email route selector and managed Resend receiving proof. The canary token
# must be 32+ random URL-safe characters and is used only to derive the exact one-time recipient.
LITOS_APPLICATION_EMAIL_ROUTE_MODE=
LITOS_RESEND_MANAGED_RECEIVING_DOMAIN=
LITOS_RESEND_MANAGED_RECEIVING_CANARY_TOKEN=
LITOS_APPLICATION_EMAIL_WEBHOOK_URL=
LITOS_APPLICATION_EMAIL_INBOUND_ENABLED=
# Resend returns this as signing_secret when the email.received webhook is created.
RESEND_WEBHOOK_SECRET=
RESEND_API_KEY=
# Optional dedicated Resend key for the Receiving API. When set, inbound content reads use this
# key while outbound mail continues to use RESEND_API_KEY. It must belong to the receiving domain's
# Resend account and have permission to GET /emails/receiving/:id.
RESEND_RECEIVING_API_KEY=
RESEND_FROM=
# Compatibility secret for non-Resend signed test providers.
LITOS_INBOUND_EMAIL_WEBHOOK_SECRET=
# AES-256-GCM key for application_profile column-level encryption (phone/address/work-auth).
# Any secret string works; scrypt derives the fixed-length key. Rotating this re-encrypts nothing
# automatically - existing rows become undecryptable, so treat it like JWT_SIGNING_SECRET (set once).
ENCRYPTION_KEY=change-me-32-chars-minimum
# Vercel Blob read-write token (Storage tab -> Create -> Blob), used to store generated resume files.
# Also required by the daily retention sweep, which deletes resume files past the window stated
# in the privacy policy.
BLOB_READ_WRITE_TOKEN=
# Absolute base URL this API is reached at, used to build resume download links. Optional:
# derived from x-forwarded-proto/host when unset, which is correct on Vercel. Set it only if the
# API is served on a different hostname than the one requests arrive on.
PUBLIC_API_BASE=
REOON_API_KEY=
MILLIONVERIFIER_API_KEY=
BOUNCEBAN_API_KEY=
# Hunter.io API key - primary provider for BOTH contact discovery (Domain Search) and
# email verification (Email Verifier). Cheapest path; falls back to Apollo + Reoon/BounceBan.
HUNTER_API_KEY=
# Apollo People Search API key (Settings -> Integrations -> API). Fallback contact source.
APOLLO_API_KEY=
# Optional JSON array of extra first-party ATS boards loaded by the daily monitor.
# Each item: {"company_name":"Acme","ats_name":"greenhouse|lever|ashby|workable","board_token":"acme","career_url":"https://..."}
JOB_MONITOR_SOURCES_JSON=[]
# THE CONTROLLED VERIFICATION PORTAL. In a nonproduction process, this enables the local or signed
# QA portal so a submission can be exercised end to end without an employer ever seeing it.
# Controlled portal recognition is always disabled when NODE_ENV=production.
# Every gate reads it as the exact string "true":
#   portalSubmission.ts  detectPortal  - without it a /qa/portal-submission URL is not a portal at all
#   applications.ts      controlledTest is false, so the request falls through to the Browserbase check
#   submissionRunner.ts  assertControlledPortalEnabled, prepareControlled and submitControlled all
#                        refuse, the last two with "Controlled portal is disabled"
# OFF BY DEFAULT because it widens what counts as a submittable application URL, and because the QA
# pages render publicly whether or not it is set. Undocumented until 2026-08-09, which meant the
# harness had almost certainly never been exercised in production: the pages loaded, and the backend
# declined to treat them as a portal. Set it wherever the shapes in
# role-quick-website/app/qa/portal-submission are meant to be run for real.
LITOS_ENABLE_TEST_PORTAL=false
# Overrides the local Chrome the controlled portal launches when the managed provider is NOT
# configured (submissionRunner.ts, controlledChromeExecutable). Defaults to the macOS Google Chrome
# path, which does not exist on Vercel - so a controlled run on a deployed backend only works through
# the managed provider, which is also the path that makes it worth running.
LITOS_TEST_BROWSER_EXECUTABLE=
# Controlled security-code E2E. These values are for a disposable local QA database, a temporary
# HTTPS tunnel, the local email-capture adapter, and a dedicated nonproduction Stratus service.
# Never populate them by pulling a production environment. See docs/SECURITY_CODE_E2E.md.
QA_API_BASE=http://127.0.0.1:3301
QA_WEBSITE_BASE=http://127.0.0.1:3300
QA_PORTAL_URL=http://127.0.0.1:3300/qa/portal-submission
QA_PORTAL_PUBLIC_BASE=
QA_CONTROLLED_PORTAL_PUBLIC=0
QA_CONTROLLED_DATABASE=0
QA_CONTROLLED_DATABASE_MARKER=
QA_RUNS=1
QA_AUTO_APPLY=0
QA_PORTAL_SHAPE=security-code
QA_APPLICATION_EMAIL_FORWARD_TO=qa-recipient@example.test
QA_EVIDENCE_PATH=
QA_SCREENSHOT_DIR=
LITOS_TEST_PORTAL_PUBLIC_ORIGIN=
LITOS_TEST_PORTAL_BINDING_SECRET=
LITOS_QA_EMAIL_CAPTURE_ENABLED=false
LITOS_QA_EMAIL_CAPTURE_URL=http://127.0.0.1:4317/emails
LITOS_QA_EMAIL_CAPTURE_TOKEN=
LITOS_QA_RECEIPT_CAPTURE_ENABLED=false
LITOS_QA_RECEIPT_CAPTURE_URL=http://127.0.0.1:4318/receipts
LITOS_QA_RECEIPT_CAPTURE_TOKEN=
BROWSER_PROVIDER=stratus-managed
STRATUS_BASE_URL=
QA_EXPECTED_STRATUS_ORIGIN=
QA_STRATUS_CREDENTIAL_SCOPE=
# Set exactly one credential supplied by the dedicated nonproduction Stratus service. A
# VERCEL_OIDC_TOKEN may be short-lived. Do not reuse or pull a production STRATUS_API_KEY.
STRATUS_API_KEY=
VERCEL_OIDC_TOKEN=
# Explicit opt-in for direct ATS API application POSTs. Leave blank or false for fill-only mode.
LITOS_ATS_API_SUBMISSION_ENABLED=false
# JSON array of employer-authorized ATS submit channels. Each item references an API key env var,
# for example {"ats":"greenhouse","board_token":"acme","api_key_env":"GH_ACME_KEY"}.
LITOS_EMPLOYER_API_SUBMISSION_CHANNELS_JSON=[]
# Reusable Lemon Squeezy share URL. It must contain /checkout/buy/, never the single-use
# /checkout/?cart= URL. The authenticated checkout endpoint adds the Litos user ID and email.
LEMONSQUEEZY_CHECKOUT_URL=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Leave false in production. Enable only in an isolated test deployment.
LEMONSQUEEZY_ACCEPT_TEST_MODE=false
# Legacy Litos Pay compatibility. Do not use these flags or two-price IDs for new Litos+ checkout.
# They remain documented only so an existing legacy checkout can be managed during migration.
LITOS_PAY_PROCESSOR_ENABLED=false
LITOS_PAY_SIGNING_SECRET=change-me-32-chars-minimum
LITOS_PAY_CHECKOUT_BASE_URL=https://api.trylitos.com
LITOS_PAY_STRIPE_ENABLED=false
STRIPE_WEEKLY_PRICE_ID=
STRIPE_MONTHLY_PRICE_ID=

# Litos+ live billing. The three Stripe Prices must be recurring USD prices for exactly
# $19.99 per week, $39.99 per month, and $89.99 every three months.
LITOS_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_WEEKLY_PRICE_ID=
STRIPE_PLUS_MONTHLY_PRICE_ID=
STRIPE_PLUS_QUARTERLY_PRICE_ID=
STRIPE_BILLING_PORTAL_RETURN_URL=https://trylitos.com/dashboard/settings#plan
LITOS_BILLING_SUCCESS_URL=https://trylitos.com/billing/return?session_id={CHECKOUT_SESSION_ID}
LITOS_BILLING_CANCEL_URL=https://trylitos.com/billing/return?status=cancelled
STRIPE_AUTOMATIC_TAX_ENABLED=false
# One recorded UTC instant. Never change this after the grandfathering migration runs.
ENTITLEMENT_V2_CUTOVER_AT=
# Deprecated return aliases read only for legacy compatibility.
LITOS_PAY_SUCCESS_URL=https://trylitos.com/billing/return
LITOS_PAY_CANCEL_URL=https://trylitos.com/billing/return?status=cancelled
STRIPE_PORTAL_RETURN_URL=https://trylitos.com/dashboard/settings#plan
# Optional first-party fallback URL for older extension clients.
UPGRADE_URL=

# ---- ranking cache, shared tier (OPTIONAL, but it is the single biggest saving) ----
#
# Without these two, src/lib/rankingCache.ts runs L1 only: a process Map with a 60 second
# TTL, on serverless. That map is cold far more often than it is warm, and every cold miss
# re-reads scoring text for the whole ranking pool out of Neon. That is what exhausted the
# Neon free tier's 5 GB/month transfer allowance on 2026-08-04 and SUSPENDED the database.
#
# Set both and the L2 tier turns on: a 15 minute shared window that survives cold starts.
# Leave either unset and the code is a deliberate no-op, so the feature ships inert until
# an Upstash database exists. Create one at upstash.com (free tier: 256 MB, 500k commands
# per month) and copy its REST URL and token.
# Provisioning Upstash through the Vercel marketplace injects KV_REST_API_URL and
# KV_REST_API_TOKEN instead of these names, and the code accepts EITHER pair, so the
# integration route needs nothing set here. Set these two only to point a deployment at a
# different Redis by hand; an explicit pair wins over the integration's.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

PORT=3001

# Server-side analytics (src/lib/serverAnalytics.ts).
#
# WITHOUT THIS, ACCOUNT-CREATION EVENTS ARE SILENTLY NOT SENT. The module is a
# deliberate no-op when the token is absent, so the feature ships dark until it
# is set in the Vercel environment.
#
# This is the PUBLIC PostHog ingestion token (phc_...), the same value the
# website already ships inside its JS bundle. It is not a secret. It exists here
# because guest sign-ups have to be reported from the server: measured
# 2026-08-09, five of seven sampled guest creations produced no PostHog traffic
# from the browser at all, so the client-side event cannot be relied on.
POSTHOG_PROJECT_TOKEN=
# Optional. Defaults to https://us.i.posthog.com.
POSTHOG_HOST=
