+            const optionRowsIn = (root) => {
+              if (!root || !root.querySelectorAll) return [];
+              const rows = [...root.querySelectorAll('[role="option"]')];
+              if (rows.length > 0) return rows;
+              /* A <ul role="listbox"> whose rows are plain <li> is the other real menu shape -
+               * Select2's results list and every hand-rolled downshift menu write it - and reading
