+               * indistinguishable downstream from "this employer offers nothing". Narrow on
+               * purpose: only when the root is a declared listbox, and only when no role=option row
+               * exists, so a properly spelled menu is never read twice. */
+              return root.getAttribute && root.getAttribute('role') === 'listbox'
+                ? [...root.querySelectorAll('li')]
