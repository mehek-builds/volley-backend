{
  "name": "litos-backend",
  "version": "1.0.1",
  "description": "Backend API for the Litos job-application Chrome extension",
  "main": "dist/index.js",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@expo-google-fonts/tinos": "0.4.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@vercel/blob": "^2.6.1",
    "axios": "^1.18.1",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "jose": "^5.9.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.0",
    "uuid": "^11.1.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "form-data": "4.0.6"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push:pg",
    "schema:check": "node scripts/check-schema-drift.mjs"
  }
}
