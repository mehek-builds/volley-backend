  "version": "1.0.0",
  "description": "Backend API for the Volley student-outreach Chrome extension",
  "main": "dist/index.js",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/multipart": "^8.3.0",
    "@vercel/blob": "^0.27.3",
    "axios": "^1.7.0",
    "docx": "^9.7.1",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.20.0",
    "drizzle-orm": "^0.30.0",
    "fastify": "^4.28.0",
    "jose": "^5.9.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
