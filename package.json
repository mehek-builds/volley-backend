{
  "name": "litos-backend",
  "version": "1.1.0",
  "description": "Backend API for the Litos job-application Chrome extension",
  "main": "dist/index.js",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@expo-google-fonts/tinos": "0.4.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@vercel/blob": "^2.6.1",
    "@vercel/oidc": "^3.8.0",
    "argon2": "^0.45.1",
    "axios": "^1.18.1",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "jose": "^5.9.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "openai": "^7.4.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.0",
    "playwright-core": "^1.61.1",
    "uuid": "^11.1.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@types/node": "^20.0.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "form-data": "4.0.6"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:smoke": "npm run build && node -e \"require('./dist/lib/emailVerification.js'); require('./dist/lib/composioApi.js')\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.api.json",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "test:e2e": "tsx e2e/applied-badge.e2e.mts && tsx e2e/grouped-inventory.e2e.mts && tsx e2e/packet-alias.e2e.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push:pg",
    "db:indexes": "node scripts/apply-performance-indexes.mjs",
    "db:job-monitor": "node scripts/apply-job-monitor-schema.mjs",
    "schema:apply-automation-consent": "node scripts/apply-automation-consent-schema.mjs",
    "db:automatic-verification": "node scripts/apply-automatic-verification-migration.mjs",
    "db:google-auth": "node scripts/apply-google-auth-migration.mjs",
    "db:password-auth": "node scripts/apply-password-auth-migration.mjs",
    "db:guest-mode": "node scripts/apply-guest-mode-schema.mjs",
    "db:base-resume": "node scripts/apply-base-resume-migration.mjs",
    "db:targeting-locations": "node scripts/apply-targeting-locations-migration.mjs",
    "db:lemon-squeezy": "node scripts/apply-lemon-squeezy-schema.mjs",
    "schema:check": "node scripts/check-schema-drift.mjs",
    "db:sponsorship": "node --import tsx scripts/apply-sponsorship-schema.mjs",
    "qa:sponsor-board": "node --import tsx scripts/qa-sponsor-board.mts",
    "sponsors:verify": "node --import tsx scripts/verify-sponsor-matches.mjs",
    "sources:verify": "node --import tsx scripts/verify-job-sources.mjs",
    "sponsors:build": "node scripts/build-h1b-sponsors.mjs",
    "sponsors:check": "node scripts/build-h1b-sponsors.mjs --check",
    "db:pipeline-stage": "node scripts/apply-pipeline-stage-schema.mjs",
    "db:application-email": "node scripts/apply-application-email-schema.mjs",
    "db:application-email-forwarding": "node scripts/apply-application-email-forwarding-schema.mjs",
    "db:application-email-receiving-proof": "node scripts/apply-application-email-receiving-proof-schema.mjs",
    "db:application-facts": "node scripts/apply-application-facts-schema.mjs",
    "db:country-work-eligibility": "node scripts/apply-country-work-eligibility-schema.mjs",
    "db:availability-window": "node scripts/apply-availability-window-schema.mjs",
    "db:setup-gaps-asked": "node scripts/apply-setup-gaps-asked-schema.mjs",
    "db:onboarding-flow": "node scripts/apply-onboarding-flow-schema.mjs",
    "db:standardized-test-scores": "node scripts/apply-standardized-test-scores-schema.mjs",
    "db:restrictive-agreements": "node scripts/apply-restrictive-agreements-schema.mjs",
    "db:consent-acceptance": "node scripts/apply-consent-acceptance-schema.mjs",
    "logo:check": "node --import tsx scripts/check-logo-coverage.mjs",
    "logo:resolve": "node --import tsx scripts/resolve-company-domains.mjs",
    "db:job-pay": "node scripts/apply-job-pay-schema.mjs",
    "db:employment-type-index": "node scripts/apply-employment-type-index.mjs",
    "db:description-digest": "node scripts/apply-description-digest.mjs",
    "db:posting-questions": "node scripts/apply-posting-questions-schema.mjs",
    "db:user-documents": "node scripts/apply-user-documents-schema.mjs",
    "setup:application-email-resend": "node scripts/setup-resend-application-email.mjs",
    "setup:application-email-receiving-canary": "node scripts/configure-resend-receiving-canary.mjs",
    "verify:classification": "tsx scripts/verify-classification.mts",
    "trial:submit-control": "tsx scripts/trial-submit-control.mts",
    "trial:portal-shapes": "tsx scripts/trial-portal-shapes.mts",
    "qa:security-code:prepare": "node scripts/prepare-qa-security-code-proof.mjs",
    "qa:guest-submissions:test": "node --import tsx --test scripts/qa-guest-submissions.test.mjs",
    "deploy:prod": "bash scripts/deploy-prod.sh"
  }
}
