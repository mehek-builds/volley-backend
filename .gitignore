# Both forms on purpose: "node_modules/" matches a DIRECTORY only, so a node_modules
# SYMLINK (what `git worktree` + a linked install leaves behind) slipped past it and got
# committed. The bare form catches the symlink too.
node_modules/
node_modules
dist/
.env
*.env.local
drizzle/meta/
*.js.map
.vercel
.env*
QA-SHIMS-README.md
render-example-resumes.cjs
