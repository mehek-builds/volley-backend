    {
      "type": "extract",
      "selector": "[data-sitekey]:not([data-size=\"invisible\" i]):not(.grecaptcha-badge):not(.grecaptcha-badge *)",
      "attribute": "data-sitekey",
      "label": "captcha_rendered_sitekey",
      "optional": true,
      "requireVisible": true,
      "timeout": 10000
