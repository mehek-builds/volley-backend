      "html": "\n  <form>\n    <label>Email<input type=\"text\" name=\"email\" /></label>\n    <label>Resume<input type=\"file\" name=\"resume\" /></label>\n    <button type=\"submit\">Submit application</button>\n  </form>\n  <div class=\"resumator-field-wrapper resumator-resume-text\" id=\"resumator-recaptcha\">\n    <div class=\"resumator-label resumator-resume-text\" id=\"resumator-recaptcha-label\">Human check</div>\n    <div class=\"resumator-input\" id=\"resumator-recaptcha-field\">\n      <div class=\"g-recaptcha\" data-sitekey=\"6LeCbWYsAAAAALW1NxDRq4uvy3jv81sqB16i0gDm\" style=\"width:304px;height:78px\">\n        <iframe title=\"reCAPTCHA\" width=\"304\" height=\"78\"\n          src=\"/recaptcha/api2/anchor?ar=1&amp;k=6LeCbWYsAAAAALW1NxDRq4uvy3jv81sqB16i0gDm&amp;co=aHR0cHM6Ly9mb3VuZGF0aW9uYWkuYXBwbHl0b2pvYi5jb206NDQz&amp;hl=en&amp;v=w_Yb7dGGXaKesJ7BMiqFJqBG&amp;size=normal&amp;anchor-ms=20000&amp;execute-ms=30000&amp;cb=tt3wzoneei2i\"></iframe>\n      </div>\n    </div>\n  </div>\n  <textarea id=\"g-recaptcha-response\" name=\"g-recaptcha-response\" class=\"g-recaptcha-response\" style=\"display:none\"></textarea>\n  <div class=\"g-recaptcha-bubble-arrow\" style=\"display:none\"></div>\n  <div class=\"g-recaptcha-bubble-arrow\" style=\"display:none\"></div>\n  <iframe title=\"recaptcha challenge\" width=\"400\" height=\"580\" style=\"display:none\"\n    src=\"/recaptcha/api2/bframe?hl=en&amp;v=w_Yb7dGGXaKesJ7BMiqFJqBG&amp;k=6LeCbWYsAAAAALW1NxDRq4uvy3jv81sqB16i0gDm&amp;bft=0dAFcWeA5TP2Jl5DT1\"></iframe>",
